tests/data/realdata/

# Scratch output from examples/*.py (each writes here; nothing committed)
fv_example_output/

# design/handoff/ (frontend spec + prototype HTML) stays per-machine and
# NOT tracked (fermi-viewer convention); copy between machines manually or
# via OneDrive.
#
# plans/ was ignored under that same convention until 2026-08-09, when it
# was deliberately opted IN (owner decision): the plan tree is the thing
# multi-session work is carried out from, so it has to survive across
# machines and sessions with git history. Note this repo is public — treat
# plan contents as publicly visible and keep credentials, unpublished
# results and private-corpus paths out of them.
#
# plans/archive/ stays per-machine and UNTRACKED (the 2026-08-09 opt-in
# covered the live plan tree only; archived legacy plans predate the
# public-visibility scrub). Ignored explicitly so a broad `git add` can
# never sweep them into a public commit.
design/
plans/archive/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# TS incremental build state
*.tsbuildinfo

